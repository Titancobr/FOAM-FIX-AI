# AI Trainer — API Keys Configuration
# =====================================
# Copy this file to .env and fill in your keys.
# The app reads these via environment variables.
#
# Usage: source .env (Linux/Mac)
# Install Ollama and pull the models before running:
#   ollama pull qwen2.5:3b
#   ollama pull qwen2.5:7b

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_LIVE_MODEL=qwen2.5:3b
OLLAMA_REPORT_MODEL=qwen2.5:7b
OLLAMA_PLANNER_MODEL=qwen2.5:7b

# Optional: for Jarvis voice. Falls back to pyttsx3 if not provided.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
